<Window x:Class="EtsTracker.App.DriverSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор водителя" Width="460" Height="520"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="58" Height="58" Background="White" CornerRadius="8" Padding="3" Margin="0,0,14,0">
                    <Image x:Name="LogoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CompanyText" Foreground="White" FontSize="24" FontWeight="Bold" FontFamily="Georgia"/>
                    <TextBlock Text="Кто сегодня за рулём?" Foreground="{StaticResource HeaderMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <Button Content="Новый водитель…" Click="OnNew"/>
            <Button x:Name="EnterButton" Content="Войти" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="OnEnter" Margin="0"/>
        </StackPanel>

        <Grid Margin="16,16,16,0">
            <ListBox x:Name="DriversList" MouseDoubleClick="OnEnter" SelectionChanged="OnSelectionChanged"
                     BorderBrush="{StaticResource BorderBrush}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding RegNumber}" FontWeight="Bold" FontSize="14" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nickname}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{Binding RankName, Mode=OneWay}"/>
                                    <Run Text="·"/>
                                    <Run Text="{Binding Truck, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyHint" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="30" Style="{StaticResource Muted}" Visibility="Collapsed"
                       Text="Водителей пока нет. Нажмите «Новый водитель…», чтобы зарегистрироваться. Рейсы, записанные раньше, достанутся первому водителю."/>
        </Grid>
    </DockPanel>
</Window>
