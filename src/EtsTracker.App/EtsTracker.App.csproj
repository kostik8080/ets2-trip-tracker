<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EtsTrackerApp</AssemblyName>
    <RootNamespace>EtsTracker.App</RootNamespace>
    <!-- Чтобы при сборке в один .exe туда попала и нативная библиотека SQLite -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtsTracker.Core\EtsTracker.Core.csproj" />
  </ItemGroup>

</Project>
