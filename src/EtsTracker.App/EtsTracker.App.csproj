<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EtsTrackerApp</AssemblyName>
    <RootNamespace>EtsTracker.App</RootNamespace>
    <!-- Чтобы при сборке в один .exe туда попала и нативная библиотека SQLite -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <!-- Значок окон: PNG, потому что на этой .ico WPF зависает при открытии окна -->
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Плагин телеметрии RenCloud/scs-sdk-plugin (MIT): трекер сам ставит его в папку игры -->
    <EmbeddedResource Include="..\..\plugins\scs-telemetry.dll" LogicalName="scs-telemetry.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtsTracker.Core\EtsTracker.Core.csproj" />
  </ItemGroup>

</Project>
