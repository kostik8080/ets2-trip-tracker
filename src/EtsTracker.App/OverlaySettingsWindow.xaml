<Window x:Class="EtsTracker.App.OverlaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оверлей поверх игры" Width="420" SizeToContent="Height"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Оверлей поверх игры" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Пока это окно открыто, оверлей показывает пример — меняйте настройки и смотрите результат."/>

        <CheckBox x:Name="EnabledBox" Content="Показывать оверлей во время игры" Margin="0,14,0,0"
                  Checked="OnChanged" Unchecked="OnChanged"/>
        <CheckBox x:Name="IdleBox" Content="Показывать и без заказа (часы и скорость)" Margin="0,6,0,0"
                  Checked="OnChanged" Unchecked="OnChanged"/>

        <TextBlock Text="Время" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RealTimeBox" Content="Реальное" Margin="0,0,18,0" Checked="OnChanged"/>
            <RadioButton x:Name="GameTimeBox" Content="Игровое" Checked="OnChanged"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Часы, время в пути и срок доставки. Игровое время в ETS2 идёт примерно в 19 раз быстрее реального."/>

        <Grid Margin="0,4,0,0">
            <TextBlock Text="Прозрачность фона" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="OpacityValue" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right"/>
        </Grid>
        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                ValueChanged="OnSliderChanged"/>

        <Grid>
            <TextBlock Text="Размер текста" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="SizeValue" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right"/>
        </Grid>
        <Slider x:Name="SizeSlider" Minimum="10" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="OnSliderChanged"/>

        <TextBlock Text="Цвет текста" Style="{StaticResource FieldLabel}"/>
        <WrapPanel x:Name="Swatches"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Свой цвет:" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
            <TextBox x:Name="ColorBox" Width="90" MaxLength="9" TextChanged="OnColorTyped"/>
            <Border x:Name="ColorPreview" Width="22" Height="22" CornerRadius="4" Margin="8,0,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
        </StackPanel>

        <Button x:Name="MoveButton" Content="Переместить оверлей" Click="OnMove" HorizontalAlignment="Left"
                Margin="0,16,0,0"/>

        <Border Background="{StaticResource AccentLightBrush}" CornerRadius="6" Padding="10,8" Margin="0,16,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                <Run FontWeight="SemiBold" Text="Ctrl+Alt+O"/><Run Text=" — показать или скрыть оверлей прямо в игре."/>
                <LineBreak/>
                <Run Text="Если оверлей не виден поверх игры, включите в настройках графики ETS2 оконный режим (окно можно развернуть на весь экран)."/>
            </TextBlock>
        </Border>

        <Button Content="Закрыть" Style="{StaticResource PrimaryButton}" Click="OnClose"
                HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
