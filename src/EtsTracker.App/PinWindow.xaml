<Window x:Class="EtsTracker.App.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIN администратора" Width="340" SizeToContent="Height"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="HintText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <TextBlock x:Name="PinLabel" Text="PIN" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="PinBox" MaxLength="8" FontSize="18" Padding="6,4"/>

        <StackPanel x:Name="RepeatPanel" Visibility="Collapsed">
            <TextBlock Text="Повторите PIN" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="RepeatBox" MaxLength="8" FontSize="18" Padding="6,4"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BadBrush}" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Отмена" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Войти" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnOk" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
