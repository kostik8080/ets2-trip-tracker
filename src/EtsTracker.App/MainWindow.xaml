<Window x:Class="EtsTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EtsTracker.App"
        Title="Трекер рейсов" Width="1360" Height="860" MinWidth="1000" MinHeight="640"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Строка расшифровки очков/зарплаты: подпись слева, сумма справа -->
        <DataTemplate x:Key="LineTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="0,0,2,0" Foreground="{Binding Brush, TargetNullValue={StaticResource TextBrush}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ───────────── Шапка ───────────── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="58" Height="58" Background="White" CornerRadius="8" Padding="3" Margin="0,0,14,0">
                        <Image x:Name="LogoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CompanyText" Foreground="White" FontSize="24" FontWeight="Bold"
                                   FontFamily="Georgia"/>
                        <TextBlock Text="Трекер рейсов Euro Truck Simulator 2" Foreground="{StaticResource HeaderMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="White" Margin="0,0,10,0">
                        <TextBlock x:Name="RegNumberText" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock x:Name="DriverNameText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DriverInfoText" Foreground="{StaticResource HeaderMutedBrush}"/>
                    </StackPanel>
                    <Button Content="Профиль" Click="OnEditProfile" Style="{StaticResource HeaderButton}"/>
                    <Button Content="Сменить водителя" Click="OnSwitchDriver" Style="{StaticResource HeaderButton}"/>
                    <Button Content="Оверлей" Click="OnOverlaySettings" Style="{StaticResource HeaderButton}"
                            ToolTip="Панель поверх игры: ход рейса, время, скорость"/>
                    <Button x:Name="DriversButton" Content="Водители" Click="OnManageDrivers" Style="{StaticResource HeaderButton}"
                            ToolTip="Ранги, допуски и роли всех водителей (для администратора)"/>
                    <Button x:Name="CompanyButton" Content="Компания" Click="OnEditCompany" Style="{StaticResource HeaderButton}" Margin="0"
                            ToolTip="Название и логотип компании"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───────────── Левая колонка ───────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="СЕЙЧАС" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0" Fill="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="StatusTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                            </StackPanel>
                            <!-- Ход рейса: шкала от погрузки до финиша -->
                            <StackPanel x:Name="TripProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <Grid>
                                    <TextBlock x:Name="ProgressStage" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ProgressPercent" HorizontalAlignment="Right" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                                <ProgressBar x:Name="TripBar" Height="12" Maximum="100" Margin="0,6,0,3"/>
                                <Grid>
                                    <TextBlock x:Name="ProgressFrom" FontSize="11" Style="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="140" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="ProgressTo" FontSize="11" Style="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="140" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock x:Name="RemainingText" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="EtaText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DeadlineText" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusDetails" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
                            <CheckBox x:Name="ConvoyBox" Content="Этот рейс — конвой" Margin="0,10,0,0"
                                      ToolTip="Отметьте до сдачи груза: рейс запишется как конвой"/>
                            <ItemsControl x:Name="NoticesList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="DemoButton" Content="Демо-рейс" Click="OnDemo" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" Padding="10,3" FontSize="12"
                                    ToolTip="Имитирует рейс без игры — чтобы посмотреть, как всё работает"/>

                            <!-- Плагин телеметрии в папке игры -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Margin="0,12,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="PluginText" TextWrapping="Wrap" FontSize="12"/>
                                    <Button x:Name="PluginButton" Click="OnPluginButton" HorizontalAlignment="Left"
                                            Margin="0,6,0,0" Padding="10,3" FontSize="12" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ЗАРПЛАТА ЗА МЕСЯЦ" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="SalaryMonthText" FontSize="26" FontWeight="Bold"/>
                            <TextBlock x:Name="MonthSummaryText" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="УРОВЕНЬ ВОДИТЕЛЯ" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="LevelText" FontSize="22" FontWeight="Bold"/>
                            <ProgressBar x:Name="LevelBar" Maximum="100" Margin="0,8,0,6"/>
                            <TextBlock x:Name="LevelHint" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="РАНГ В КОМПАНИИ" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="RankText" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="NextRankText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <ProgressBar x:Name="RankBar" Maximum="100" Margin="0,8,0,0"/>
                            <TextBlock x:Name="PermitsText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────────── Вкладки ───────────── -->
            <TabControl Grid.Column="2" Padding="0,12,0,0" Background="Transparent" BorderThickness="0">
                <TabItem Header="  Статистика  ">
                    <DataGrid x:Name="StatsGrid" RowHeight="30" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Показатель" Binding="{Binding Label}" Width="*"/>
                            <DataGridTextColumn Header="Текущий месяц" Binding="{Binding Month}" Width="170"
                                                ElementStyle="{StaticResource NumberCell}"/>
                            <DataGridTextColumn Header="Всего" Binding="{Binding Total}" Width="170"
                                                ElementStyle="{StaticResource NumberCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="  Рейсы  ">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="TripsGrid" SelectionChanged="OnTripSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="92"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="88"/>
                                <DataGridTextColumn Header="Груз" Binding="{Binding Cargo}" Width="*" MinWidth="100"/>
                                <DataGridTextColumn Header="Класс" Binding="{Binding Class}" Width="100"/>
                                <DataGridTextColumn Header="Км" Binding="{Binding Km}" Width="52" ElementStyle="{StaticResource NumberCell}"/>
                                <DataGridTextColumn Header="Очки" Binding="{Binding Score}" Width="64" ElementStyle="{StaticResource NumberCell}"/>
                                <DataGridTextColumn Header="Зарплата" Binding="{Binding Salary}" Width="82" ElementStyle="{StaticResource NumberCell}"/>
</DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                            <Grid>
                                <TextBlock x:Name="NoTripText" Text="Рейсов пока нет. Возьмите заказ в игре — он запишется сам."
                                           TextWrapping="Wrap" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                                <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TripTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TripRoute" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TripMeta" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" LineHeight="19"/>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Тип поездки" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="KindBox" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Класс груза" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="ClassBox" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                                            </StackPanel>
                                        </Grid>
                                        <WrapPanel x:Name="TripAdminButtons" Margin="0,10,0,0">
                                            <Button Content="Сохранить и пересчитать" Style="{StaticResource PrimaryButton}"
                                                    Click="OnReclassify" Padding="10,5"/>
                                            <Button Content="Удалить" Click="OnDeleteTrip" Padding="10,5" Margin="0"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="TripAdminHint" Style="{StaticResource Muted}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                                                   Text="Тип поездки и класс груза поправляет администратор компании."/>

                                        <TextBlock Text="ОЧКИ ТРЕКЕРА" Style="{StaticResource CardTitle}" Margin="0,18,0,6"/>
                                        <ItemsControl x:Name="ScoreLines" ItemTemplate="{StaticResource LineTemplate}"/>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                            <TextBlock x:Name="ScoreTotal" FontWeight="Bold"/>
                                        </Border>

                                        <TextBlock Text="ЗАРПЛАТА ВТК" Style="{StaticResource CardTitle}" Margin="0,18,0,6"/>
                                        <ItemsControl x:Name="SalaryLines" ItemTemplate="{StaticResource LineTemplate}"/>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                            <TextBlock x:Name="SalaryTotal" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="  Рейтинг  ">
                    <Grid>
                        <!-- Вход на сервер компании -->
                        <ScrollViewer x:Name="ServerConnectPanel" VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource Card}" MaxWidth="460" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Сервер компании" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Войдите, и ваши рейсы будут отправляться на общий сервер, а здесь появится рейтинг всех водителей."/>
                                    <TextBlock Text="Адрес сервера" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ServerUrlBox"/>
                                    <TextBlock Text="Никнейм" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ServerNicknameBox" MaxLength="40"/>
                                    <TextBlock Text="Пароль (от 8 символов)" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="ServerPasswordBox" Padding="4,3"/>
                                    <TextBlock Text="Код приглашения (только для регистрации)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ServerInviteBox" MaxLength="20"/>
                                    <TextBlock x:Name="ServerErrorText" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap"
                                               Margin="0,10,0,0" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Войти" Style="{StaticResource PrimaryButton}" Click="OnServerLogin"/>
                                        <Button Content="Зарегистрироваться" Click="OnServerRegister" Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Общий рейтинг -->
                        <DockPanel x:Name="ServerRatingPanel" Visibility="Collapsed">
                            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="ServerAccountText" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SyncStatusText" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Обновить" Click="OnRatingRefresh"/>
                                            <Button Content="Страница рейтинга" Click="OnOpenRatingPage"/>
                                            <Button Content="Выйти" Click="OnServerLogout" Margin="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="InvitePanel" Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Пригласить водителя с рангом:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="RankInviteBox" Width="170" DisplayMemberPath="Name" SelectedValuePath="Value"
                                                  Margin="0,0,8,0"/>
                                        <Button Content="Создать код" Click="OnCreateInvite"/>
                                        <TextBox x:Name="InviteCodeBox" IsReadOnly="True" Width="130" FontWeight="Bold"
                                                 VerticalContentAlignment="Center" Visibility="Collapsed"
                                                 ToolTip="Одноразовый код: отправьте его водителю"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="СЕЙЧАС В РЕЙСЕ" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="LiveEmptyText" Text="Сейчас никто не в рейсе." Style="{StaticResource Muted}"/>
                                    <ItemsControl x:Name="LiveList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="280" Margin="0,4,10,4" Padding="10,8" CornerRadius="6"
                                                        Background="{StaticResource PageBrush}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Cargo}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Route}" TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,5,0,3"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="12" Style="{StaticResource Muted}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Достижения выбранного водителя -->
                            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" MaxHeight="150">
                                <DockPanel>
                                    <TextBlock x:Name="RatingAchTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4"
                                               Text="Выберите водителя в таблице, чтобы увидеть его достижения."/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="RatingAchList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2,6,2" Padding="8,3" CornerRadius="10" ToolTip="{Binding Tip}"
                                                            Background="{StaticResource AccentLightBrush}">
                                                        <TextBlock FontSize="12">
                                                            <Run Text="{Binding Icon, Mode=OneWay}" FontFamily="Segoe UI Emoji"/>
                                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <ComboBox x:Name="RatingPeriodBox" Width="120" Margin="0,0,8,0" SelectionChanged="OnRatingFilterChanged">
                                    <ComboBoxItem Content="Неделя" Tag="week"/>
                                    <ComboBoxItem Content="Месяц" Tag="month"/>
                                    <ComboBoxItem Content="Всё время" Tag="all"/>
                                </ComboBox>
                                <ComboBox x:Name="RatingMetricBox" Width="130" Margin="0,0,14,0" SelectionChanged="OnRatingFilterChanged">
                                    <ComboBoxItem Content="По очкам" Tag="score"/>
                                    <ComboBoxItem Content="По км" Tag="km"/>
                                    <ComboBoxItem Content="По зарплате" Tag="salary"/>
                                    <ComboBoxItem Content="По рейсам" Tag="delivered"/>
                                </ComboBox>
                                <TextBlock x:Name="RatingTotalsText" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <DataGrid x:Name="RatingGrid" RowHeight="30" SelectionChanged="OnRatingDriverSelected">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="#" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Медаль: цветной кружок с местом (цветные эмодзи WPF не рисует) -->
                                                <Border Width="22" Height="22" CornerRadius="11" Background="{Binding MedalBrush}">
                                                    <TextBlock Text="{Binding Place}" FontWeight="Bold" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{Binding PlaceBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Водитель" Binding="{Binding Nickname}" Width="*" MinWidth="130"/>
                                    <DataGridTextColumn Header="Ранг" Binding="{Binding Rank}" Width="140"/>
                                    <DataGridTextColumn Header="Очки" Binding="{Binding Score}" Width="70" ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Км" Binding="{Binding Km}" Width="70" ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Зарплата" Binding="{Binding Salary}" Width="90" ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Рейсы" Binding="{Binding Delivered}" Width="62" ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Без царапин" Binding="{Binding Perfect}" Width="100" ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Штрафы" Binding="{Binding Fines}" Width="72" ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Ур." Binding="{Binding Level}" Width="44" ElementStyle="{StaticResource NumberCell}"/>
                                    <DataGridTextColumn Header="Достижения" Binding="{Binding Achievements}" Width="104" ElementStyle="{StaticResource NumberCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="  Достижения  ">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="AchSummary" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AchPercent" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                                <ProgressBar x:Name="AchBar" Maximum="100" Margin="0,8,0,6"/>
                                <TextBlock x:Name="AchLatest" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AchList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Width="262" Margin="0,0,10,10"
                                                Background="{Binding CardBrush}" Opacity="{Binding CardOpacity}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" FontSize="28" FontFamily="Segoe UI Emoji"
                                                           Foreground="{Binding IconBrush}" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                                               TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6"/>
                                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6"
                                                                 Visibility="{Binding BarVisibility}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding StatusBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="  Графики  ">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="PeriodBox" Width="140" SelectionChanged="OnPeriodChanged">
                                <ComboBoxItem Content="30 дней"/>
                                <ComboBoxItem Content="12 месяцев"/>
                            </ComboBox>
                        </StackPanel>
                        <UniformGrid Rows="3">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ПРОБЕГ, КМ" Style="{StaticResource CardTitle}"/>
                                    <local:BarChart x:Name="KmChart" BarBrush="{StaticResource ChartBlueBrush}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ЗАРПЛАТА ВТК, €" Style="{StaticResource CardTitle}"/>
                                    <local:BarChart x:Name="SalaryChart" BarBrush="{StaticResource ChartLightBrush}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ОЧКИ ТРЕКЕРА" Style="{StaticResource CardTitle}"/>
                                    <local:BarChart x:Name="ScoreChart" BarBrush="{StaticResource GoodBrush}"/>
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="  Ставки  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="СТАВКА ЗА 1 КМ С ГРУЗОМ" Style="{StaticResource CardTitle}"/>
                                    <ItemsControl x:Name="RatesList" ItemTemplate="{StaticResource LineTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="BonusTitle" Style="{StaticResource CardTitle}"/>
                                    <ItemsControl x:Name="BonusList" ItemTemplate="{StaticResource LineTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="ПРОЧИЕ НАДБАВКИ" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="OtherRatesText" TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Ставки, очки и список грузов меняются в файлах company.json, scoring.json и cargo.json в папке data. После правки перезапустите программу."
                                               TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                                    <Button Content="Открыть папку data" Click="OnOpenData" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
