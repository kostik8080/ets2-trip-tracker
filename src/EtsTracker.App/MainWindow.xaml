<Window x:Class="EtsTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EtsTracker.App"
        Title="ВТК — трекер рейсов" Width="1360" Height="860" MinWidth="1000" MinHeight="640"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Строка расшифровки очков/зарплаты: подпись слева, сумма справа -->
        <DataTemplate x:Key="LineTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="0,0,2,0" Foreground="{Binding Brush, TargetNullValue={StaticResource TextBrush}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ───────────── Шапка ───────────── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CompanyText" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Трекер рейсов Euro Truck Simulator 2" Foreground="#9CA3AF"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock x:Name="RegNumberText" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock x:Name="DriverNameText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DriverInfoText" Foreground="#9CA3AF"/>
                    </StackPanel>
                    <Button Content="Профиль" Click="OnEditProfile"/>
                    <Button Content="Сменить водителя" Click="OnSwitchDriver" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───────────── Левая колонка ───────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="СЕЙЧАС" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0" Fill="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="StatusTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusDetails" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
                            <CheckBox x:Name="ConvoyBox" Content="Этот рейс — конвой" Margin="0,10,0,0"
                                      ToolTip="Отметьте до сдачи груза: рейс запишется как конвой"/>
                            <ItemsControl x:Name="NoticesList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="DemoButton" Content="Демо-рейс" Click="OnDemo" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" Padding="10,3" FontSize="12"
                                    ToolTip="Имитирует рейс без игры — чтобы посмотреть, как всё работает"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ЗАРПЛАТА ЗА МЕСЯЦ" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="SalaryMonthText" FontSize="26" FontWeight="Bold"/>
                            <TextBlock x:Name="MonthSummaryText" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="УРОВЕНЬ ВОДИТЕЛЯ" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="LevelText" FontSize="22" FontWeight="Bold"/>
                            <ProgressBar x:Name="LevelBar" Maximum="100" Margin="0,8,0,6"/>
                            <TextBlock x:Name="LevelHint" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="РАНГ В КОМПАНИИ" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="RankText" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="NextRankText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <ProgressBar x:Name="RankBar" Maximum="100" Margin="0,8,0,0"/>
                            <TextBlock x:Name="PermitsText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────────── Вкладки ───────────── -->
            <TabControl Grid.Column="2" Padding="0,12,0,0" Background="Transparent" BorderThickness="0">
                <TabItem Header="  Статистика  ">
                    <DataGrid x:Name="StatsGrid" RowHeight="30" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Показатель" Binding="{Binding Label}" Width="*"/>
                            <DataGridTextColumn Header="Текущий месяц" Binding="{Binding Month}" Width="170"
                                                ElementStyle="{StaticResource NumberCell}"/>
                            <DataGridTextColumn Header="Всего" Binding="{Binding Total}" Width="170"
                                                ElementStyle="{StaticResource NumberCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="  Рейсы  ">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="TripsGrid" SelectionChanged="OnTripSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="92"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="88"/>
                                <DataGridTextColumn Header="Груз" Binding="{Binding Cargo}" Width="*" MinWidth="100"/>
                                <DataGridTextColumn Header="Класс" Binding="{Binding Class}" Width="100"/>
                                <DataGridTextColumn Header="Км" Binding="{Binding Km}" Width="52" ElementStyle="{StaticResource NumberCell}"/>
                                <DataGridTextColumn Header="Очки" Binding="{Binding Score}" Width="64" ElementStyle="{StaticResource NumberCell}"/>
                                <DataGridTextColumn Header="Зарплата" Binding="{Binding Salary}" Width="82" ElementStyle="{StaticResource NumberCell}"/>
</DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                            <Grid>
                                <TextBlock x:Name="NoTripText" Text="Рейсов пока нет. Возьмите заказ в игре — он запишется сам."
                                           TextWrapping="Wrap" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                                <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TripTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TripRoute" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TripMeta" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" LineHeight="19"/>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Тип поездки" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="KindBox" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Класс груза" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="ClassBox" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                                            </StackPanel>
                                        </Grid>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Сохранить и пересчитать" Style="{StaticResource PrimaryButton}"
                                                    Click="OnReclassify" Padding="10,5"/>
                                            <Button Content="Удалить" Click="OnDeleteTrip" Padding="10,5" Margin="0"/>
                                        </WrapPanel>

                                        <TextBlock Text="ОЧКИ ТРЕКЕРА" Style="{StaticResource CardTitle}" Margin="0,18,0,6"/>
                                        <ItemsControl x:Name="ScoreLines" ItemTemplate="{StaticResource LineTemplate}"/>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                            <TextBlock x:Name="ScoreTotal" FontWeight="Bold"/>
                                        </Border>

                                        <TextBlock Text="ЗАРПЛАТА ВТК" Style="{StaticResource CardTitle}" Margin="0,18,0,6"/>
                                        <ItemsControl x:Name="SalaryLines" ItemTemplate="{StaticResource LineTemplate}"/>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                            <TextBlock x:Name="SalaryTotal" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="  Графики  ">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="PeriodBox" Width="140" SelectionChanged="OnPeriodChanged">
                                <ComboBoxItem Content="30 дней"/>
                                <ComboBoxItem Content="12 месяцев"/>
                            </ComboBox>
                        </StackPanel>
                        <UniformGrid Rows="3">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ПРОБЕГ, КМ" Style="{StaticResource CardTitle}"/>
                                    <local:BarChart x:Name="KmChart" BarBrush="{StaticResource ChartBlueBrush}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ЗАРПЛАТА ВТК, €" Style="{StaticResource CardTitle}"/>
                                    <local:BarChart x:Name="SalaryChart" BarBrush="{StaticResource AccentBrush}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="ОЧКИ ТРЕКЕРА" Style="{StaticResource CardTitle}"/>
                                    <local:BarChart x:Name="ScoreChart" BarBrush="{StaticResource GoodBrush}"/>
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="  Ставки  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="СТАВКА ЗА 1 КМ С ГРУЗОМ" Style="{StaticResource CardTitle}"/>
                                    <ItemsControl x:Name="RatesList" ItemTemplate="{StaticResource LineTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="BonusTitle" Style="{StaticResource CardTitle}"/>
                                    <ItemsControl x:Name="BonusList" ItemTemplate="{StaticResource LineTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="ПРОЧИЕ НАДБАВКИ" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="OtherRatesText" TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Ставки, очки и список грузов меняются в файлах company.json, scoring.json и cargo.json в папке data. После правки перезапустите программу."
                                               TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                                    <Button Content="Открыть папку data" Click="OnOpenData" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
