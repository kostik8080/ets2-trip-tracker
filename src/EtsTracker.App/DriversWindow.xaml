<Window x:Class="EtsTracker.App.DriversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профили на этом компьютере" Width="930" Height="520"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Профили на этом компьютере" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Здесь только те, кто играет на этом компьютере. После входа на сервер ранг, допуски и роль водителя приходят с сервера. Дважды щёлкните по водителю, чтобы изменить его."/>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Сменить мой PIN…" Click="OnChangeMyPin"/>
            <Button x:Name="ResetPinButton" Content="Сбросить PIN" Click="OnResetPin"
                    ToolTip="Если администратор забыл PIN: при следующем входе он придумает новый"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Новый водитель…" Click="OnNew"/>
            <Button x:Name="EditButton" Content="Изменить…" Style="{StaticResource PrimaryButton}" Click="OnEdit"/>
            <Button Content="Закрыть" IsCancel="True" Margin="0"/>
        </StackPanel>
        </Grid>

        <DataGrid x:Name="DriversGrid" MouseDoubleClick="OnEdit" SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding RegNumber}" Width="50"/>
                <DataGridTextColumn Header="Никнейм" Binding="{Binding Nickname}" Width="*"/>
                <DataGridTextColumn Header="Ранг" Binding="{Binding Rank}" Width="150"/>
                <DataGridTextColumn Header="Грузовик" Binding="{Binding Truck}" Width="140"/>
                <DataGridTextColumn Header="Допуски" Binding="{Binding Permits}" Width="150"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="140"/>
                <DataGridTextColumn Header="PIN" Binding="{Binding PinState}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
