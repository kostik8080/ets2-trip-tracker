<Window x:Class="EtsTracker.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оверлей трекера" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="Segoe UI" FontWeight="SemiBold">
    <Window.Resources>
        <!-- Тень под текстом, чтобы он читался и без фона -->
        <Style TargetType="TextBlock">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Panel" CornerRadius="10" Padding="14,10" BorderThickness="2" BorderBrush="Transparent">
        <StackPanel x:Name="Root">
            <!-- Всплывающее сообщение: новое достижение -->
            <TextBlock x:Name="ToastText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,6"
                       Foreground="#FFD54F"/>
            <Grid>
                <TextBlock x:Name="ClockText"/>
                <TextBlock x:Name="SpeedText" HorizontalAlignment="Right" Margin="24,0,0,0"/>
            </Grid>

            <StackPanel x:Name="TripPanel" Margin="0,6,0,0">
                <TextBlock x:Name="CargoText" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="RouteText" TextTrimming="CharacterEllipsis" Opacity="0.85"/>
                <Grid Margin="0,6,0,2">
                    <Border x:Name="BarTrack" CornerRadius="3" Height="8" Opacity="0.25"/>
                    <Border x:Name="BarFill" CornerRadius="3" Height="8" HorizontalAlignment="Left"/>
                </Grid>
                <TextBlock x:Name="RemainingText"/>
                <TextBlock x:Name="EtaText" Opacity="0.9" TextWrapping="Wrap"/>
                <TextBlock x:Name="DeadlineText" Opacity="0.9"/>
                <TextBlock x:Name="DamageText" Opacity="0.85" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock x:Name="IdleText" Margin="0,4,0,0" Opacity="0.85" Visibility="Collapsed"/>
            <TextBlock x:Name="MoveHint" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                       Text="Перетащите мышью. Затем нажмите «Готово» в настройках."/>
        </StackPanel>
    </Border>
</Window>
