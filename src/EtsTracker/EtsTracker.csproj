<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EtsTracker</AssemblyName>
    <RootNamespace>EtsTracker</RootNamespace>
    <!-- Чтобы при сборке в один .exe туда попала и нативная библиотека SQLite -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtsTracker.Core\EtsTracker.Core.csproj" />
  </ItemGroup>

</Project>
